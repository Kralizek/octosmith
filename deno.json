{
  "workspace": [
    "./packages/octosmith",
    "./packages/cli"
  ],
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/yaml": "jsr:@std/yaml@^1",
    "@std/path": "jsr:@std/path@^1",
    "ajv/2020": "npm:ajv@8.17.1/dist/2020.js",
    "libsodium-wrappers": "npm:libsodium-wrappers@0.8.4",
    "@hooksmith/core": "jsr:@hooksmith/core@^0.12.0"
  },
  "tasks": {
    "check": "deno task sync:schemas && deno fmt --check && deno lint && deno task check:docs && deno task test",
    "test": "deno task sync:schemas && deno test -A",
    "cli": "deno task sync:schemas && deno run -A packages/cli/mod.ts",
    "check:docs": "deno run --allow-read=packages scripts/check_export_docs.ts",
    "sync:schemas": "bash .github/workflows/scripts/sync-schemas.sh"
  },
  "lock": false
}
