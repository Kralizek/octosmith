{
  "repository": "issue-tracker",
  "template": "repository:issues",
  "settings": {
    "hasProjects": false,
    "hasDiscussions": false,
    "hasIssues": true,
    "hasWiki": false,
    "merge": {
      "deleteBranchOnMerge": true
    }
  },
  "teams": [
    {
      "team": "platform-team",
      "permission": {
        "kind": "built-in",
        "name": "maintain"
      }
    }
  ],
  "collections": "explicit"
}
