{
  "repository": "api-service",
  "template": "repository:code",
  "settings": {
    "hasProjects": false,
    "hasDiscussions": false,
    "hasIssues": false,
    "hasWiki": false,
    "merge": {
      "allowSquashMerge": true,
      "allowMergeCommit": false,
      "allowRebaseMerge": false,
      "deleteBranchOnMerge": true
    }
  },
  "teams": [
    {
      "team": "platform-team",
      "permission": {
        "kind": "built-in",
        "name": "maintain"
      }
    }
  ],
  "rulesets": [
    {
      "name": "protect-default-branch",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "refName": {
          "include": [
            "~DEFAULT_BRANCH"
          ]
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non-fast-forward"
        },
        {
          "type": "pull-request",
          "requiredReviewThreadResolution": true,
          "allowedMergeMethods": [
            "squash"
          ]
        }
      ]
    }
  ],
  "environments": [
    {
      "name": "automation",
      "secrets": [
        {
          "name": "PACKAGE_FEED_SECRET",
          "source": "PACKAGE_FEED_SECRET"
        }
      ],
      "variables": [
        {
          "name": "PACKAGE_FEED_CLIENT_ID",
          "value": "PACKAGE_FEED_CLIENT_ID-value"
        },
        {
          "name": "PACKAGE_FEED_TENANT_ID",
          "value": "PACKAGE_FEED_TENANT_ID-value"
        }
      ]
    }
  ],
  "files": [
    {
      "path": ".github/workflows/request-review.yml",
      "ensure": "exact",
      "content": "name: Request review\n\non:\n  issue_comment:\n    types:\n      - created\n\npermissions:\n  contents: read\n\njobs:\n  request-review:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Request review\n        run: echo \"Requesting review\"\n"
    }
  ],
  "collections": "explicit",
  "actions": {
    "secrets": [
      {
        "name": "REVIEW_BOT_TOKEN",
        "source": "REVIEW_BOT_TOKEN"
      }
    ],
    "variables": [
      {
        "name": "NOTIFICATION_CHANNEL_ID",
        "value": "NOTIFICATION_CHANNEL_ID-value"
      }
    ]
  }
}
