{
  "repository": "config-repository",
  "template": "config",
  "settings": {
    "hasProjects": false,
    "hasDiscussions": false,
    "hasIssues": false,
    "hasWiki": false,
    "merge": {
      "deleteBranchOnMerge": true
    }
  },
  "teams": [
    {
      "team": "platform-team",
      "permission": {
        "kind": "built-in",
        "name": "maintain"
      }
    },
    {
      "team": "configuration-maintainers",
      "permission": {
        "kind": "custom",
        "name": "configuration-editor"
      }
    }
  ]
}
