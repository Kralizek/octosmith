{
  "$schema": "https://opencli.org/draft.json",
  "opencli": "0.1.0",
  "info": {
    "title": "octosmith",
    "version": "0.1.0",
    "description": "Declaratively manage GitHub resources."
  },
  "options": [
    {
      "name": "--version",
      "description": "Print the Octosmith CLI version."
    },
    {
      "name": "--help",
      "description": "Show help."
    }
  ],
  "commands": [
    {
      "name": "plan",
      "description": "Show required changes.",
      "arguments": [
        {
          "name": "resource",
          "required": false,
          "description": "Primary resource target."
        }
      ],
      "options": [
        {
          "name": "--path",
          "aliases": [
            "-p"
          ],
          "description": "Configuration directory.",
          "arguments": [
            {
              "name": "path",
              "required": true
            }
          ]
        },
        {
          "name": "--format",
          "description": "Output format: text or json.",
          "arguments": [
            {
              "name": "format",
              "required": true
            }
          ]
        },
        {
          "name": "--verbose",
          "aliases": [
            "-v"
          ],
          "description": "Show additional result details."
        },
        {
          "name": "--trace",
          "description": "Emit GitHub API request traces to stderr."
        },
        {
          "name": "--events-output",
          "description": "Write Hooksmith resource events as NDJSON.",
          "arguments": [
            {
              "name": "path",
              "required": true
            }
          ]
        },
        {
          "name": "--out",
          "description": "Write the persisted plan artifact.",
          "arguments": [
            {
              "name": "path",
              "required": true
            }
          ]
        }
      ]
    },
    {
      "name": "apply",
      "description": "Apply required changes.",
      "arguments": [
        {
          "name": "resource",
          "required": false,
          "description": "Primary resource target."
        }
      ],
      "options": [
        {
          "name": "--path",
          "aliases": [
            "-p"
          ],
          "description": "Configuration directory.",
          "arguments": [
            {
              "name": "path",
              "required": true
            }
          ]
        },
        {
          "name": "--format",
          "description": "Output format: text or json.",
          "arguments": [
            {
              "name": "format",
              "required": true
            }
          ]
        },
        {
          "name": "--verbose",
          "aliases": [
            "-v"
          ],
          "description": "Show additional result details."
        },
        {
          "name": "--trace",
          "description": "Emit GitHub API request traces to stderr."
        },
        {
          "name": "--events-output",
          "description": "Write Hooksmith resource events as NDJSON.",
          "arguments": [
            {
              "name": "path",
              "required": true
            }
          ]
        },
        {
          "name": "--plan",
          "description": "Apply a persisted plan artifact.",
          "arguments": [
            {
              "name": "path",
              "required": true
            }
          ]
        }
      ]
    },
    {
      "name": "resource",
      "description": "Resource operations.",
      "commands": [
        {
          "name": "list",
          "description": "List resources within configured scope."
        },
        {
          "name": "create",
          "description": "Create a resource from a template.",
          "arguments": [
            {
              "name": "template",
              "required": true,
              "description": "Template to instantiate."
            }
          ],
          "options": [
            {
              "name": "--name",
              "description": "Name for the new resource.",
              "arguments": [
                {
                  "name": "name",
                  "required": true
                }
              ]
            },
            {
              "name": "--path",
              "aliases": [
                "-p"
              ],
              "description": "Configuration directory.",
              "arguments": [
                {
                  "name": "path",
                  "required": true
                }
              ]
            },
            {
              "name": "--format",
              "description": "Output format: text or json.",
              "arguments": [
                {
                  "name": "format",
                  "required": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "template",
      "description": "Template operations.",
      "commands": [
        {
          "name": "validate",
          "description": "Validate configuration and templates without accessing GitHub.",
          "arguments": [
            {
              "name": "template",
              "required": false,
              "description": "Template target."
            }
          ],
          "options": [
            {
              "name": "--path",
              "aliases": [
                "-p"
              ],
              "description": "Configuration directory.",
              "arguments": [
                {
                  "name": "path",
                  "required": true
                }
              ]
            },
            {
              "name": "--format",
              "description": "Output format: text or json.",
              "arguments": [
                {
                  "name": "format",
                  "required": true
                }
              ]
            }
          ]
        },
        {
          "name": "permissions",
          "description": "Analyze worst-case permissions for the selected template or configuration.",
          "arguments": [
            {
              "name": "template",
              "required": false,
              "description": "Template target."
            }
          ],
          "options": [
            {
              "name": "--path",
              "aliases": [
                "-p"
              ],
              "description": "Configuration directory.",
              "arguments": [
                {
                  "name": "path",
                  "required": true
                }
              ]
            },
            {
              "name": "--format",
              "description": "Output format: text or json.",
              "arguments": [
                {
                  "name": "format",
                  "required": true
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
