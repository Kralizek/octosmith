{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kralizek/octosmith/master/schemas/template.schema.json",
  "title": "OctoSmith repository template",
  "type": "object",
  "additionalProperties": false,
  "required": ["match"],
  "properties": {
    "match": {
      "$ref": "#/$defs/selector"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "rulesets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleset"
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environment"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "names": {
          "$ref": "#/$defs/stringList"
        },
        "teams": {
          "$ref": "#/$defs/stringList"
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/propertyValue"
          }
        }
      }
    },
    "propertyValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": {
          "$ref": "#/$defs/repositorySettings"
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/teamPermission"
          }
        },
        "secrets": {
          "$ref": "#/$defs/stringList"
        },
        "variables": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "repositorySettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "has_wiki": {
          "type": "boolean"
        },
        "has_issues": {
          "type": "boolean"
        },
        "has_projects": {
          "type": "boolean"
        },
        "has_discussions": {
          "type": "boolean"
        },
        "delete_branch_on_merge": {
          "type": "boolean"
        },
        "merge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "merge_commit": {
              "type": "boolean"
            },
            "rebase": {
              "type": "boolean"
            },
            "squash": {
              "type": "boolean"
            },
            "squash_commit_title": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "teamPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "permission"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "permission": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "enforcement", "rules"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "enum": ["branch", "tag"]
        },
        "enforcement": {
          "type": "string",
          "enum": ["disabled", "evaluate", "active"]
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref_name": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "include": {
                  "$ref": "#/$defs/stringList"
                },
                "exclude": {
                  "$ref": "#/$defs/stringList"
                }
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "secrets": {
          "$ref": "#/$defs/stringList"
        },
        "variables": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "file": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ensure", "source"],
          "properties": {
            "ensure": {
              "const": "exact"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ensure"],
          "properties": {
            "ensure": {
              "const": "absent"
            }
          }
        }
      ]
    }
  }
}
