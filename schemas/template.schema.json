{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kralizek/octosmith/master/schemas/template.schema.json",
  "title": "Octosmith template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "match",
    "repository"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "repository"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "includes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "match": {
      "$ref": "./selectors/repository.schema.json"
    },
    "repository": {
      "$ref": "./resources/repository.schema.json"
    }
  }
}
