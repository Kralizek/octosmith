{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kralizek/octosmith/master/schemas/octosmith.schema.json",
  "title": "Octosmith configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "organization",
    "repositories"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "$ref": "./scopes/repository.schema.json"
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "file_changes": {
          "$ref": "#/$defs/fileChanges"
        }
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "teams": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/propertyValue"
          }
        },
        "visibility": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "public",
                "private",
                "internal"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "public",
                  "private",
                  "internal"
                ]
              }
            }
          ]
        }
      }
    },
    "propertyValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection_management": {
          "type": "string",
          "enum": [
            "explicit",
            "strict"
          ]
        },
        "unmatched_repositories": {
          "type": "string",
          "enum": [
            "error",
            "ignore"
          ]
        }
      }
    },
    "fileChanges": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "pull_request"
            },
            "commit": {
              "$ref": "#/$defs/fileChangesCommit"
            },
            "pull_request": {
              "$ref": "#/$defs/fileChangesPullRequest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "direct"
            },
            "commit": {
              "$ref": "#/$defs/fileChangesCommit"
            }
          }
        }
      ]
    },
    "fileChangesCommit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fileChangesPullRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch_prefix": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
