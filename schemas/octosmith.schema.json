{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kralizek/octosmith/master/schemas/octosmith.schema.json",
  "title": "OctoSmith configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "organization",
    "scope"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/selector"
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "teams": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/propertyValue"
          }
        },
        "visibility": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "public",
                "private",
                "internal"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "public",
                  "private",
                  "internal"
                ]
              }
            }
          ]
        }
      }
    },
    "propertyValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    }
  }
}
