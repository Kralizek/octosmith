{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kralizek/octosmith/master/schemas/selectors/repository.schema.json",
  "title": "Octosmith repository selector",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "names": {
      "$ref": "#/$defs/selectorStringList"
    },
    "teams": {
      "$ref": "#/$defs/selectorStringList"
    },
    "properties": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/propertyValue"
      }
    },
    "visibility": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "public",
            "private",
            "internal"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "public",
              "private",
              "internal"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "propertyValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "selectorStringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
