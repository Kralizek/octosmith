{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kralizek/octosmith/master/schemas/resources/repository.schema.json",
  "title": "Octosmith repository configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "settings": {
      "$ref": "#/$defs/repositorySettings"
    },
    "teams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/teamPermission"
      }
    },
    "custom_properties": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "actions": {
      "$ref": "#/$defs/actionsSettings"
    },
    "dependabot": {
      "$ref": "#/$defs/dependabot"
    },
    "rulesets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleset"
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environment"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "required": [],
  "$defs": {
    "ownedStringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repositorySettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private",
            "internal"
          ]
        },
        "has_wiki": {
          "type": "boolean"
        },
        "has_issues": {
          "type": "boolean"
        },
        "has_projects": {
          "type": "boolean"
        },
        "has_discussions": {
          "type": "boolean"
        },
        "has_pull_requests": {
          "type": "boolean"
        },
        "pull_request_creation_policy": {
          "type": "string",
          "enum": [
            "all",
            "collaborators_only"
          ]
        },
        "is_template": {
          "type": "boolean"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "delete_branch_on_merge": {
          "type": "boolean"
        },
        "allow_forking": {
          "type": "boolean"
        },
        "archived": {
          "type": "boolean"
        },
        "web_commit_signoff_required": {
          "type": "boolean"
        },
        "merge": {
          "$ref": "#/$defs/mergeSettings"
        },
        "security_and_analysis": {
          "$ref": "#/$defs/securityAndAnalysis"
        },
        "website": {
          "type": [
            "string",
            "null"
          ]
        },
        "topics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mergeSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "squash": {
          "type": "boolean"
        },
        "merge_commit": {
          "type": "boolean"
        },
        "rebase": {
          "type": "boolean"
        },
        "auto_merge": {
          "type": "boolean"
        },
        "update_branch": {
          "type": "boolean"
        },
        "squash_commit_title": {
          "type": "string",
          "enum": [
            "pull-request-title",
            "commit-or-pull-request-title"
          ]
        },
        "squash_commit_message": {
          "type": "string",
          "enum": [
            "pull-request-body",
            "commit-messages",
            "blank"
          ]
        },
        "merge_commit_title": {
          "type": "string",
          "enum": [
            "pull-request-title",
            "merge-message"
          ]
        },
        "merge_commit_message": {
          "type": "string",
          "enum": [
            "pull-request-title",
            "pull-request-body",
            "blank"
          ]
        }
      }
    },
    "securityFeatureStatus": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled"
      ]
    },
    "securityAndAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "advanced_security": {
          "$ref": "#/$defs/securityFeatureStatus"
        },
        "code_security": {
          "$ref": "#/$defs/securityFeatureStatus"
        },
        "secret_scanning": {
          "$ref": "#/$defs/securityFeatureStatus"
        },
        "secret_scanning_push_protection": {
          "$ref": "#/$defs/securityFeatureStatus"
        },
        "secret_scanning_ai_detection": {
          "$ref": "#/$defs/securityFeatureStatus"
        }
      }
    },
    "teamPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "permission"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "permission": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "enum": [
            "branch",
            "tag",
            "push"
          ]
        },
        "enforcement": {
          "type": "string",
          "enum": [
            "disabled",
            "evaluate",
            "active"
          ]
        },
        "bypass_actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bypassActor"
          }
        },
        "conditions": {
          "$ref": "#/$defs/rulesetConditions"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "bypassActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "bypass_mode"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "integration",
            "organization-admin",
            "repository-role",
            "team",
            "deploy-key",
            "user"
          ]
        },
        "actor_id": {
          "type": "integer"
        },
        "bypass_mode": {
          "type": "string",
          "enum": [
            "always",
            "pull-request",
            "exempt"
          ]
        }
      }
    },
    "rulesetConditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref_name": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": {
              "$ref": "#/$defs/ownedStringList"
            },
            "exclude": {
              "$ref": "#/$defs/ownedStringList"
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "creation",
            "update",
            "deletion",
            "required_linear_history",
            "merge_queue",
            "required_deployments",
            "required_signatures",
            "pull_request",
            "required_status_checks",
            "non_fast_forward",
            "commit_message_pattern",
            "commit_author_email_pattern",
            "committer_email_pattern",
            "branch_name_pattern",
            "tag_name_pattern",
            "workflows",
            "code_scanning",
            "code_quality",
            "code_coverage",
            "copilot_code_review",
            "license_compliance_scanning",
            "file_path_restriction",
            "max_file_path_length",
            "file_extension_restriction",
            "max_file_size"
          ]
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "secrets": {
          "$ref": "#/$defs/secretList"
        },
        "variables": {
          "$ref": "#/$defs/variableList"
        }
      }
    },
    "file": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ensure",
            "source"
          ],
          "properties": {
            "ensure": {
              "const": "exact"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ensure",
            "source"
          ],
          "properties": {
            "ensure": {
              "const": "exists"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ensure"
          ],
          "properties": {
            "ensure": {
              "const": "absent"
            }
          }
        }
      ]
    },
    "actionsSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "$ref": "#/$defs/secretList"
        },
        "variables": {
          "$ref": "#/$defs/variableList"
        },
        "enabled": {
          "type": "boolean"
        },
        "allowed_actions": {
          "type": "string",
          "enum": [
            "all",
            "local_only",
            "selected"
          ]
        },
        "sha_pinning_required": {
          "type": "boolean"
        },
        "selected_actions": {
          "$ref": "#/$defs/selectedActions"
        },
        "oidc": {
          "$ref": "#/$defs/actionsOidc"
        }
      }
    },
    "selectedActions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github_owned_allowed": {
          "type": "boolean"
        },
        "verified_allowed": {
          "type": "boolean"
        },
        "patterns_allowed": {
          "$ref": "#/$defs/ownedStringList"
        }
      }
    },
    "actionsOidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_claim_template": {
          "$ref": "#/$defs/subjectClaimTemplate"
        },
        "immutable_subject": {
          "type": "boolean"
        }
      }
    },
    "subjectClaimTemplate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "default"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "organization"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "claims"
          ],
          "properties": {
            "source": {
              "const": "custom"
            },
            "claims": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "dependabot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "$ref": "#/$defs/secretList"
        }
      }
    },
    "secretBinding": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "variableBinding": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "value"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "secretList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/secretBinding"
      }
    },
    "variableList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variableBinding"
      }
    }
  }
}
